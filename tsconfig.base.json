{
  "compilerOptions": {
    "target": "ES2023",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ],
      "@server/*": [
        "./src/server/*"
      ],
      "@client/*": [
        "./src/client/*"
      ],
      "@desktop/*": [
        "./src/desktop/*"
      ],
      "@scripts/*": [
        "./scripts/*"
      ]
    }
  }
}
