{
  "name": "yt-downloader",
  "version": "1.4.0",
  "private": true,
  "description": "Desktop app for downloading high-quality music (MP3 320, M4A, original Opus, FLAC, WAV) and video with a quality picker from YouTube and 1000+ other sites.",
  "type": "module",
  "main": "dist/desktop.cjs",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "start": "electron .",
    "start:web": "node dist/app.cjs",
    "dev": "tsx scripts/build.ts --dev && electron .",
    "dev:web": "concurrently -k -n build,server -c magenta,blue \"tsx scripts/build.ts --watch\" \"tsx watch src/server/index.ts --no-open\"",
    "package": "tsx scripts/build.ts && tsx scripts/package.ts",
    "package:win": "tsx scripts/build.ts && tsx scripts/package.ts --targets win-x64",
    "package:linux": "tsx scripts/build.ts && tsx scripts/package.ts --targets linux-x64,linux-arm64",
    "package:server": "tsx scripts/build.ts && tsx scripts/package-server.ts",
    "icon": "tsx scripts/make-icon.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "version": "tsx scripts/release-notes.ts",
    "lint": "oxlint --deny-warnings && stylelint \"src/**/*.css\"",
    "lint:fix": "oxlint --fix && stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"test/**/*.ts\" \"scripts/**/*.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
